# ─────────────────────────────────────────────────────────────
# Questista environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────

# Supabase project (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to client

# AI provider (used by the daily-question generator cron)
# Default uses Google Gemini via the AI SDK. Swap the provider in src/lib/ai.ts.
GEMINI_API_KEY=your-gemini-key

# Secret that protects the daily-question cron route (/api/cron/generate-today)
CRON_SECRET=your-random-secret

# Public site URL (used for auth redirects + OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000